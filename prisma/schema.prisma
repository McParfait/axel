generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  tenants   Tenant[]
}

model Tenant {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  code                String   @unique
  name                String
  status              String
  gapTolerancePercent Decimal  @default(0.50) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  sites               Site[]
  products            Product[]
  trucks              Truck[]
  drivers             Driver[]
  tanks               Tank[]
  missions            Mission[]
  alerts              Alert[]
}

model Site {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  type          String
  name          String
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  geofenceMeters Int     @default(250)
  depotMissions Mission[] @relation("MissionDepot")
  stationMissions Mission[] @relation("MissionStation")
  tanks         Tank[]
}

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  code     String
  name     String
  tanks    Tank[]
  missions Mission[]
  @@unique([tenantId, code])
}

model Truck {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  plate        String
  compartments Compartment[]
  missions     Mission[]
  @@unique([tenantId, plate])
}

model Compartment {
  id           String        @id @default(cuid())
  truckId      String
  truck        Truck         @relation(fields: [truckId], references: [id])
  index        Int
  capacityL    Decimal       @db.Decimal(12, 3)
  loadingLines LoadingLine[]
  @@unique([truckId, index])
}

model Driver {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  name     String
  missions Mission[]
}

model Tank {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  name           String
  capacityL      Decimal         @db.Decimal(12, 3)
  unloadingLines UnloadingLine[]
}

model Mission {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  code            String
  status          String
  truckId         String
  truck           Truck           @relation(fields: [truckId], references: [id])
  driverId        String
  driver          Driver          @relation(fields: [driverId], references: [id])
  depotId         String
  depot           Site            @relation("MissionDepot", fields: [depotId], references: [id])
  stationId       String
  station         Site            @relation("MissionStation", fields: [stationId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  loadingNote     String?
  loadedL         Decimal         @default(0) @db.Decimal(12, 3)
  inTruckL        Decimal         @default(0) @db.Decimal(12, 3)
  unloadedL       Decimal         @default(0) @db.Decimal(12, 3)
  alertLossL      Decimal         @default(0) @db.Decimal(12, 3)
  gapTransitL     Decimal         @default(0) @db.Decimal(12, 3)
  gapUnloadL      Decimal         @default(0) @db.Decimal(12, 3)
  gapTotalL       Decimal         @default(0) @db.Decimal(12, 3)
  gapPercent      Decimal         @default(0) @db.Decimal(8, 4)
  withinTolerance Boolean?
  certifiedAt     DateTime?
  arrivedAt       DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  loadingLines    LoadingLine[]
  unloadingLines  UnloadingLine[]
  events          MissionEvent[]
  alerts          Alert[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model LoadingLine {
  id            String      @id @default(cuid())
  missionId     String
  mission       Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  compartmentId String
  compartment   Compartment @relation(fields: [compartmentId], references: [id])
  litres        Decimal     @db.Decimal(12, 3)
  @@unique([missionId, compartmentId])
}

model UnloadingLine {
  id        String  @id @default(cuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tankId    String
  tank      Tank    @relation(fields: [tankId], references: [id])
  litres    Decimal @db.Decimal(12, 3)
  @@unique([missionId, tankId])
}

model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type      String
  label     String
  detail    String
  status    String
  createdAt DateTime @default(now())
  @@index([missionId, createdAt])
}

model Alert {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type      String
  litres    Decimal  @db.Decimal(12, 3)
  source    String   @default("sim")
  createdAt DateTime @default(now())
}
